QMainWindow, QWidget#centralwidget { background-color:#0b1220; color:#e5eaf3; font-family:"Segoe UI"; font-size:10pt; }
QWidget { color:#e5eaf3; }
QTabWidget::pane { background:#111c2e; border:1px solid #26364d; border-radius:10px; top:-1px; }
QTabBar::tab { background:#162338; color:#9eacc2; padding:12px 18px; margin-right:5px; border:1px solid #26364d; border-bottom:none; border-top-left-radius:8px; border-top-right-radius:8px; }
QTabBar::tab:selected { background:#1d2e49; color:#70b7ff; border-color:#3689e8; border-bottom:3px solid #3689e8; }
QGroupBox { background:#111c2e; border:1px solid #26364d; border-radius:10px; margin-top:14px; padding:14px 10px 10px 10px; font-weight:600; }
QGroupBox::title { subcontrol-origin:margin; left:14px; padding:0 7px; color:#78baff; }
QLabel { background:transparent; color:#dce5f2; }
QLineEdit,QTextEdit,QPlainTextEdit,QComboBox,QSpinBox,QDoubleSpinBox,QDateEdit,QTimeEdit,QDateTimeEdit { background:#0c1728; color:#edf3fc; border:1px solid #30435e; border-radius:6px; padding:7px 9px; selection-background-color:#2563a6; selection-color:white; min-height:20px; }
QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus,QComboBox:focus,QSpinBox:focus,QDoubleSpinBox:focus,QDateEdit:focus,QTimeEdit:focus,QDateTimeEdit:focus { border:1px solid #4298f5; }
QComboBox::drop-down { border:none; width:25px; }
QComboBox QAbstractItemView { background:#162338; color:#e5eaf3; selection-background-color:#24558a; border:1px solid #30435e; }
QPushButton { background:#1d3554; color:#eaf3ff; border:1px solid #345477; border-radius:7px; padding:8px 14px; min-height:20px; font-weight:600; }
QPushButton:hover { background:#264a73; border-color:#4b9cf0; } QPushButton:pressed { background:#16304e; } QPushButton:disabled { background:#202b3b; color:#718096; border-color:#29384b; }
QTableWidget,QTableView,QTreeWidget,QTreeView { background:#0e192a; alternate-background-color:#142238; color:#e5eaf3; gridline-color:#26364d; border:1px solid #2a3c55; border-radius:7px; selection-background-color:#244e7b; selection-color:white; }
QHeaderView::section { background:#1a2b43; color:#9fcfff; padding:9px 7px; border:none; border-right:1px solid #2b405c; border-bottom:1px solid #345477; font-weight:700; }
QTableCornerButton::section { background:#1a2b43; border:none; }
QScrollBar:vertical { background:#0d1828; width:11px; margin:2px; } QScrollBar::handle:vertical { background:#354b68; min-height:25px; border-radius:5px; } QScrollBar::handle:vertical:hover { background:#4a6b91; } QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height:0; }
QScrollBar:horizontal { background:#0d1828; height:11px; margin:2px; } QScrollBar::handle:horizontal { background:#354b68; min-width:25px; border-radius:5px; } QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal { width:0; }
QCheckBox,QRadioButton { spacing:8px; color:#dce5f2; } QCheckBox::indicator,QRadioButton::indicator { width:16px; height:16px; }
QCheckBox::indicator { border:1px solid #526985; border-radius:4px; background:#0c1728; } QCheckBox::indicator:checked { background:#2878c7; border-color:#56a8ff; }
QRadioButton::indicator { border:1px solid #526985; border-radius:8px; background:#0c1728; } QRadioButton::indicator:checked { background:#3b9af2; border:4px solid #0c1728; }
QProgressBar { background:#0c1728; border:1px solid #30435e; border-radius:5px; text-align:center; color:#e5eaf3; } QProgressBar::chunk { background:#3289dc; border-radius:4px; }
QMenu { background:#162338; color:#e5eaf3; border:1px solid #30435e; } QMenu::item:selected { background:#24558a; }
QToolTip { background:#1a2b43; color:#f1f5fb; border:1px solid #4a6b91; padding:5px; }
